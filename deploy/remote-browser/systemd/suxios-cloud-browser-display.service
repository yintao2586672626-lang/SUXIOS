[Unit]
Description=SUXIOS cloud browser virtual display
After=network.target

[Service]
Type=simple
User=suxios-browser
Group=suxios-browser
ExecStart=/usr/bin/Xvfb :99 -screen 0 1440x960x24 -nolisten tcp
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
