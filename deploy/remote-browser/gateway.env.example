SUXIOS_CLOUD_BROWSER_BIND=127.0.0.1
SUXIOS_CLOUD_BROWSER_PORT=8787
SUXIOS_CLOUD_BROWSER_ENCRYPTED_ROOT=/var/lib/suxios-cloud-browser/profiles
SUXIOS_CLOUD_BROWSER_RUNTIME_ROOT=/run/suxios-cloud-browser/profiles
SUXIOS_CLOUD_BROWSER_RECEIPT_CHAIN=/var/lib/suxios-cloud-browser/receipts/chain.jsonl
SUXIOS_CLOUD_BROWSER_PROFILE_KEY_FILE=/run/credentials/suxios-cloud-browser-gateway.service/profile-master-key
SUXIOS_CLOUD_BROWSER_CONTROL_TOKEN_FILE=/run/credentials/suxios-cloud-browser-gateway.service/control-token
SUXIOS_CLOUD_BROWSER_PHP_BINARY=/usr/bin/php
SUXIOS_CLOUD_BROWSER_BRIDGE_SCRIPT=/var/www/suxios/current/scripts/cloud_browser_gateway_bridge.php
SUXIOS_CLOUD_BROWSER_EXECUTABLE=/usr/bin/chromium
SUXIOS_CLOUD_BROWSER_DISPLAY=:99
SUXIOS_CLOUD_BROWSER_CDP_PORT=9223
SUXIOS_CLOUD_BROWSER_VIEWER_URL=http://127.0.0.1:6080/vnc.html?autoconnect=true&resize=scale
SUXIOS_CLOUD_BROWSER_LOGIN_TTL_SECONDS=900
SUXIOS_CLOUD_BROWSER_PROFILE_SESSION_TTL_SECONDS=604800
