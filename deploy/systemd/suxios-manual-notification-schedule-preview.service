[Unit]
Description=SUXIOS manual notification schedule preview (safe default)
After=mariadb.service php8.3-fpm.service
ConditionPathExists=/var/www/suxios/current/think

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/suxios/current
Environment=TZ=Asia/Shanghai
# Intentionally omits the explicit send flag. Enabling this unit can only preview due rows.
ExecStart=/usr/bin/php -d memory_limit=192M think manual-notification:schedule --preview --mode=test --limit=100
Nice=10
CPUQuota=20%
MemoryMax=192M
TasksMax=12
TimeoutStartSec=2min
UMask=0027
