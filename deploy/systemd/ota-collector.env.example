# Copy to /etc/suxios/ota-collector.env with mode 0600.
# This file contains scope identifiers only. Never add Cookie, token, Profile
# content, password, Authorization, webhook, or other session material.
SUXIOS_OTA_CLOUD_USER_ID=
# Stable, non-secret identifier for this physical server/collector device.
# Rotating it requires an explicit confirmed binding rotation after re-login.
SUXIOS_OTA_CLOUD_DEVICE_ID=
SUXIOS_OTA_CLOUD_HOTEL_ID=
SUXIOS_OTA_CLOUD_SOURCE_IDS=
SUXIOS_OTA_CLOUD_PLATFORMS=ctrip,meituan
