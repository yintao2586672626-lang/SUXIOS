[Unit]
Description=SUXIOS hourly hotel monitoring broadcast (test group only)
After=network-online.target mariadb.service php8.3-fpm.service
Wants=network-online.target
ConditionPathExists=/var/www/suxios/current/think
StartLimitIntervalSec=2h
StartLimitBurst=10

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/suxios/current
Environment=TZ=Asia/Shanghai
EnvironmentFile=/etc/suxios/cloud-monitor.env
ExecStart=/usr/bin/php -d memory_limit=384M think hotel-monitor:wechat-broadcast --hotel-id=${SUXIOS_MONITOR_HOTEL_ID} --test-robot-id=${SUXIOS_MONITOR_TEST_ROBOT_ID} --with-visual-card
Restart=on-failure
RestartSec=2min
Nice=10
CPUQuota=80%
MemoryMax=512M
TasksMax=32
TimeoutStartSec=15min
UMask=0027
