CLOUD_AUTOMATION_STATE_DIR=/var/lib/suxios-cloud-automation
CLOUD_AUTOMATION_BASE_URL=https://127.0.0.1
CLOUD_AUTOMATION_REQUIRED_PLATFORMS=ctrip,meituan
CLOUD_DATA_BRIDGE_STATE_DIR=/var/lib/suxios-cloud-automation/bridge
CLOUD_DATA_BRIDGE_ACTOR_USER_ID=1
