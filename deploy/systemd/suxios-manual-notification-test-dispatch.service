[Unit]
Description=SUXIOS manual notification verified test-group dispatcher
After=mariadb.service php8.3-fpm.service
ConditionPathExists=/var/www/suxios/current/think

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/suxios/current
Environment=TZ=Asia/Shanghai
EnvironmentFile=/etc/suxios/manual-notification-test-dispatch.env
# Explicit test-only delivery. The command and database binding jointly reject
# every other hotel, robot, notification scope, or delivery mode.
ExecStartPre=/usr/bin/php deploy/systemd/verify_manual_notification_test_dispatch.php --hotel-id=${SUXIOS_MANUAL_NOTIFICATION_HOTEL_ID} --robot-id=${SUXIOS_MANUAL_NOTIFICATION_ROBOT_ID} --require-enabled
ExecStart=/usr/bin/php -d memory_limit=192M think manual-notification:schedule --dispatch --mode=test --hotel-id=${SUXIOS_MANUAL_NOTIFICATION_HOTEL_ID} --robot-id=${SUXIOS_MANUAL_NOTIFICATION_ROBOT_ID} --limit=5
Nice=10
CPUQuota=20%
MemoryMax=192M
TasksMax=12
TimeoutStartSec=3min
UMask=0027

[Install]
WantedBy=multi-user.target
