# Copy this file to a controlled location outside Git, then set RELEASE_ENV_FILE to that path.
# Do not commit real production secrets.

APP_DEBUG=false
APP_TRACE=false
APP_TIMEZONE=Asia/Shanghai

# Current production contract: one application host and one active release.
# These paths must be absolute, writable by the PHP user, and outside /var/www/suxios/releases.
SUXIOS_DEPLOYMENT_MODE=single_instance
SUXIOS_REQUIRE_PERSISTENT_LOCAL_STATE=true
SUXIOS_CACHE_PATH=/var/lib/suxios/app-cache
SUXIOS_LOCAL_LOCK_PATH=/var/lib/suxios/app-locks

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=CHANGE_ME_PRODUCTION_DB_NAME
DB_USER=CHANGE_ME_LEAST_PRIVILEGE_DB_USER
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD
DB_PORT=3306
DB_CHARSET=utf8mb4
DB_PREFIX=

# Must match the secret used when saving encrypted ai_model_configs.api_key_encrypted.
AI_CONFIG_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
SUXI_DISABLE_MODEL_CALLS=0

# WeCom custom-app encrypted callback. Keep real values in the controlled release env only.
WECOM_INBOUND_TOKEN=
WECOM_INBOUND_AES_KEY=
WECOM_INBOUND_CORP_ID=
WECOM_INBOUND_PUBLIC_BASE_URL=
SUXIOS_WECOM_AIBOT_ID=
SUXIOS_WECOM_AIBOT_SECRET=
SUXIOS_WECOM_AIBOT_RELAY_TOKEN=
SUXIOS_LOCAL_API_BASE=http://127.0.0.1:8080

# LLM provider API keys are configured through the AI model config UI / database,
# not through env-based OpenAIClient.
